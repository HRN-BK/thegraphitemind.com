{"file":"the-graphite-mind/longform/engine/cast.py","func":"figure","code":[[192,"def figure(who=\"zee\", pose=\"stand\", mood=\"happy\", blink=False, look=(0, 0), phase=0.0, extras=(), hold=None,",false],[193,"           scale=1.0, face=\"front\"):",false],[194,"    \"\"\"who: key in CHARACTERS. pose: key in POSES. hold: optional Drawing placed at the right hand",false],[195,"    (drawn around (0,0)). extras: additional accessory names.\"\"\"",false],[196,"    custom = CUSTOM_FIGURES.get(who)",true],[197,"    if custom is not None:",true],[198,"        d = custom(pose=pose, mood=mood, blink=blink, look=look, phase=phase, extras=extras, hold=hold, face=face)",false],[199,"        return d.transformed(s=scale) if scale != 1.0 else d",false],[200,"    spec = CHARACTERS[who]",true],[201,"    r, torso, leg, arm = AGES[spec.get(\"age\", \"adult\")]",true],[202,"    d = Drawing()",true],[203,"    hip_y = -leg",true],[204,"    sh_y = hip_y - torso",true],[205,"    head_cy = sh_y - r - 6",true],[206,"    pose_spec = POSES.get(pose)",true],[207,"    if pose == \"walk\":",true],[208,"        sw = math.sin(phase * 2 * math.pi)",false],[209,"        pose_spec = ((-14 - 18 * sw, -8 - 10 * sw), (14 - 18 * sw, 8 - 10 * sw), (-4 + 22 * sw, -4 + 12 * max(0, sw)),",false],[210,"                     (4 - 22 * sw, 4 + 12 * max(0, -sw)))",false],[211,"    la, ra, ll, rl = pose_spec",true],[212,"    sitting = pose in SITTING",true],[213,"    extras = list(spec.get(\"extras\", [])) + list(extras)",true],[214,"    top, top_col, pants = spec[\"top\"], spec[\"top_col\"], spec[\"pants\"]",true],[215,"    skin = spec.get(\"skin\", C[\"skin\"])          # optional per-character skin tone (default: Gray's ivory)",true],[216,"    if top == \"bare\":",true],[217,"        top_col = skin",false],[218,"",false],[219,"    # legs",false],[220,"    if sitting:",true],[221,"        hip_y = -leg * 0.55",false],[222,"        sh_y = hip_y - torso",false],[223,"        head_cy = sh_y - r - 6",false],[224,"        legs = [[(-12, hip_y), (-12 + leg * 0.55, hip_y), (-12 + leg * 0.55, 0)],",false],[225,"                [(12, hip_y), (12 + leg * 0.55, hip_y), (12 + leg * 0.55, 0)]]",false],[226,"        if pose == \"sit_side\":",false],[227,"            legs = [[(-8, hip_y), (-8 + leg * 0.6, hip_y + 4)], [(8, hip_y), (8 + leg * 0.62, hip_y + 8)]]",false],[228,"    else:",false],[229,"        legs = [_limb(-12, hip_y, ll[0], ll[1], leg * 0.5, leg * 0.5),",true],[230,"                _limb(12, hip_y, rl[0], rl[1], leg * 0.5, leg * 0.5)]",true],[231,"    for L in legs:",true],[232,"        if pants and top not in (\"dress\", \"toga\"):",true],[233,"            _tube(d, L, pants, 16 if spec.get(\"age\") != \"kid\" else 13)",true],[234,"        else:",false],[235,"            d.line(L, LW)",false],[236,"        fx, fy = L[-1]",true],[237,"        d.fill(ellipse_pts(fx + 8, fy - 2, 16, 8), INK, width=2)   # shoe",true],[238,"",false],[239,"    # body / clothes",false],[240,"    sx = 30 if spec.get(\"age\") != \"kid\" else 24",true],[241,"    body = [(-sx, sh_y + 6), (sx, sh_y + 6), (sx * 0.9, hip_y + 6), (-sx * 0.9, hip_y + 6), (-sx, sh_y + 6)]",true],[242,"    if top in (\"dress\", \"toga\", \"labcoat\"):",true],[243,"        body = [(-sx, sh_y + 6), (sx, sh_y + 6), (sx * 1.4, hip_y + leg * 0.55), (-sx * 1.4, hip_y + leg * 0.55),",false],[244,"                (-sx, sh_y + 6)]",false],[245,"        if top == \"labcoat\":",false],[246,"            body[2] = (sx * 1.2, hip_y + leg * 0.3)",false],[247,"            body[3] = (-sx * 1.2, hip_y + leg * 0.3)",false],[248,"    d.fill(catmull(body, 3), top_col, width=LW)",true],[249,"    if top == \"hoodie\":",true],[250,"        d.line(catmull([(-sx * 0.55, sh_y + 8), (0, sh_y + 30), (sx * 0.55, sh_y + 8)], 6), LW * 0.7)",true],[251,"        d.line([(-8, sh_y + 30), (-10, sh_y + 58)], LW * 0.6)",true],[252,"        d.line([(8, sh_y + 30), (10, sh_y + 58)], LW * 0.6)",true],[253,"        d.line([(-sx * 0.55, hip_y - 4), (-sx * 0.4, hip_y - 36), (sx * 0.4, hip_y - 36), (sx * 0.55, hip_y - 4)], LW * 0.6)",true],[254,"    elif top == \"cardigan\":",false],[255,"        d.line([(0, sh_y + 8), (0, hip_y + 4)], LW * 0.7)",false],[256,"        for yy in (sh_y + 40, sh_y + 70, sh_y + 100):",false],[257,"            d.dot((8, yy), 4)",false],[258,"    elif top in (\"shirt\", \"suit\"):",false],[259,"        d.line([(-10, sh_y + 8), (0, sh_y + 24), (10, sh_y + 8)], LW * 0.7)",false],[260,"        if top == \"suit\":",false],[261,"            d.line([(-12, sh_y + 8), (0, hip_y), (12, sh_y + 8)], LW * 0.6, C[\"white\"])",false],[262,"    elif top == \"toga\":",false],[263,"        d.line(catmull([(-sx, sh_y + 10), (sx * 0.4, hip_y - 20), (sx * 1.2, hip_y + 30)], 6), LW * 0.7)",false],[264,"    if \"hide\" in extras:         # simple hide wrap at the hips (early humans)",true],[265,"        hx = sx * 0.95",false],[266,"        d.fill([(-hx, hip_y - 26), (hx, hip_y - 26), (hx * 1.08, hip_y + 18), (hx * 0.5, hip_y + 8), (0, hip_y + 22),",false],[267,"                (-hx * 0.5, hip_y + 8), (-hx * 1.08, hip_y + 18), (-hx, hip_y - 26)], (150, 112, 76), width=LW * 0.8)",false],[268,"    if \"apron\" in extras:",true],[269,"        d.fill([(-sx * 0.7, sh_y + 40), (sx * 0.7, sh_y + 40), (sx * 0.85, hip_y + 20), (-sx * 0.85, hip_y + 20),",false],[270,"                (-sx * 0.7, sh_y + 40)], C[\"green\"], width=LW * 0.8)",false],[271,"    if \"tie\" in extras:",true],[272,"        d.fill([(0, sh_y + 20), (8, sh_y + 30), (0, sh_y + 80), (-8, sh_y + 30), (0, sh_y + 20)], C[\"red\"], width=3)",false],[273,"    if \"backpack\" in extras:",true],[274,"        d.rect(-sx - 22, sh_y + 14, -sx + 4, hip_y - 4, C[\"blue\"], width=LW, r=8)",false],[275,"",false],[276,"    # arms",false],[277,"    hands = []",true],[278,"    for side, (a1, a2) in ((-1, la), (1, ra)):",true],[279,"        A = _limb(side * sx * 0.95, sh_y + 12, a1, a2, arm * 0.5, arm * 0.5)",true],[280,"        if top in (\"hoodie\", \"cardigan\", \"shirt\", \"suit\", \"labcoat\", \"suit_space\"):",true],[281,"            _tube(d, A[:2] + [((A[1][0] + A[2][0]) / 2, (A[1][1] + A[2][1]) / 2)], top_col, 14)",true],[282,"            d.line([((A[1][0] + A[2][0]) / 2, (A[1][1] + A[2][1]) / 2), A[2]], LW)",true],[283,"        else:",false],[284,"            _tube(d, A[:2], top_col, 14) if top in (\"tee\",) else None",false],[285,"            d.line(A[1:] if top == \"tee\" else A, LW)",false],[286,"        hands.append(A[2])",true],[287,"        d.dot(A[2], 9)",true],[288,"",false],[289,"    # head",false],[290,"    cx, cy = 0.0, head_cy",true],[291,"    d.circle(cx, cy, r, skin, width=LW * 1.1)",true],[292,"    for side in (-1, 1):   # ears",true],[293,"        d.fill(ellipse_pts(cx + side * (r + 2), cy + 6, 8, 12, -80 if side > 0 else 100, 80 if side > 0 else 260, 10),",true],[294,"               skin, width=LW * 0.8)",true],[295,"    dark_skin = 0.2126 * skin[0] + 0.7152 * skin[1] + 0.0722 * skin[2] < 128",true],[296,"    hair = spec[\"hair\"]",true],[297,"    if hair != \"none\":",true],[298,"        _hair(d, hair, cx, cy, r)",true],[299,"    ex = r * 0.36",true],[300,"    ey = cy - r * 0.02",true],[301,"    closed = blink or mood == \"sleepy\"",true],[302,"    for side in (-1, 1):",true],[303,"        ecx = cx + side * ex + look[0]",true],[304,"        ecy = ey + look[1]",true],[305,"        if closed:",true],[306,"            d.line(catmull([(ecx - 10, ecy), (ecx, ecy + 6), (ecx + 10, ecy)], 5), LW)",false],[307,"        else:",false],[308,"            ry = 14 if mood != \"shocked\" else 17",true],[309,"            if dark_skin:        # eye whites keep the face readable on darker skin tones",true],[310,"                d.ellipse(ecx, ecy, 12 if mood != \"shocked\" else 14, ry + 3, C[\"white\"], outline=False)",false],[311,"            d.ellipse(ecx, ecy, 9 if mood != \"shocked\" else 11, ry, INK, outline=False)",true],[312,"            d.dot((ecx - 3, ecy - 5), 3.4, C[\"white\"])",true],[313,"        bp = BROWS.get(mood, BROWS[\"neutral\"])",true],[314,"        pts = [(ecx - side * x * 0.9 - look[0] * 0.3, ecy + y * 0.9) for x, y in bp]",true],[315,"        d.line(catmull(pts, 5), LW * 0.85)",true],[316,"    if mood in (\"happy\", \"laugh\", \"proud\"):",true],[317,"        for side in (-1, 1):",true],[318,"            d.ellipse(cx + side * r * 0.6, cy + r * 0.3, 11, 7, C[\"pink\"], outline=False)",true],[319,"    if mood == \"worried\":",true],[320,"        d.fill(ellipse_pts(cx + r * 0.85, cy - r * 0.55, 6, 9) , C[\"sky\"], width=2.5)",false],[321,"    _mouth(d, mood, cx, cy, r, braces=\"braces\" in extras)",true],[322,"    if \"glasses\" in extras:",true],[323,"        for side in (-1, 1):",false],[324,"            d.line(ellipse_pts(cx + side * ex + look[0], ey + look[1], 19, 17), LW * 0.7)",false],[325,"        d.line([(cx - ex + 19, ey), (cx + ex - 19, ey)], LW * 0.7)",false],[326,"    if \"sunburn\" in extras:      # red cheeks and nose (drawn under the mouth/glasses)",true],[327,"        for side in (-1, 1):",false],[328,"            d.ellipse(cx + side * r * 0.56, cy + r * 0.26, 17, 11, (232, 96, 84), outline=False)",false],[329,"        d.ellipse(cx, cy + r * 0.2, 10, 8, (232, 96, 84), outline=False)",false],[330,"    if \"sunglasses\" in extras:",true],[331,"        for side in (-1, 1):",false],[332,"            lx = cx + side * ex + look[0]",false],[333,"            d.fill(catmull([(lx - 24, ey - 14 + look[1]), (lx + 24, ey - 14 + look[1]), (lx + 20, ey + 16 + look[1]),",false],[334,"                            (lx, ey + 22 + look[1]), (lx - 20, ey + 16 + look[1]), (lx - 24, ey - 14 + look[1])], 4),",false],[335,"                   C[\"black\"], width=LW * 0.7)",false],[336,"            d.line([(lx - 14, ey - 8 + look[1]), (lx - 6, ey - 10 + look[1])], 3, C[\"white\"])",false],[337,"        d.line([(cx - ex + 24, ey - 8 + look[1]), (cx + ex - 24, ey - 8 + look[1])], LW * 0.8)",false],[338,"        for side in (-1, 1):",false],[339,"            d.line([(cx + side * (ex + 24), ey - 8 + look[1]), (cx + side * r * 0.97, ey - 4)], LW * 0.8)",false],[340,"    if \"mustache\" in extras or \"mustache_brown\" in extras:",true],[341,"        col = C[\"white\"] if \"mustache\" in extras else C[\"hair_brown\"]",false],[342,"        my = cy + r * 0.3",false],[343,"        d.fill(catmull([(-26, my + 6), (-14, my - 6), (0, my), (14, my - 6), (26, my + 6), (0, my + 8), (-26, my + 6)], 3),",false],[344,"               col, width=LW * 0.7)",false],[345,"    if \"beard\" in extras:",true],[346,"        d.fill(catmull([(-r * 0.7, cy + r * 0.2), (-r * 0.5, cy + r * 1.3), (0, cy + r * 1.7), (r * 0.5, cy + r * 1.3),",false],[347,"                        (r * 0.7, cy + r * 0.2)], 4) + [(-r * 0.7, cy + r * 0.2)], C[\"gray_lt\"], width=LW)",false],[348,"        _mouth(d, \"neutral\", cx, cy - 4, r)",false],[349,"    if \"gray_temples\" in extras:",true],[350,"        for side in (-1, 1):",false],[351,"            d.line([(cx + side * r * 0.92, cy - r * 0.1), (cx + side * r * 0.98, cy - r * 0.45)], LW * 1.6, C[\"gray_lt\"])",false],[352,"    if \"grad_cap\" in extras:",true],[353,"        d.fill([(cx - r * 1.1, cy - r * 0.95), (cx, cy - r * 1.35), (cx + r * 1.1, cy - r * 0.95), (cx, cy - r * 0.6),",false],[354,"                (cx - r * 1.1, cy - r * 0.95)], INK, width=2)",false],[355,"        d.line([(cx + r * 0.2, cy - r * 0.95), (cx + r * 0.9, cy - r * 0.7), (cx + r * 0.9, cy - r * 0.2)], 3, C[\"yellow\"])",false],[356,"    if \"helmet\" in extras:",true],[357,"        d.line(ellipse_pts(cx, cy, r * 1.28, r * 1.28), LW * 1.2)",false],[358,"        d.line(ellipse_pts(cx, cy, r * 1.1, r * 1.1, 200, 250, 10), LW * 0.8, C[\"white\"])",false],[359,"    if hold is not None:",true],[360,"        hx, hy = hands[1]",false],[361,"        d = d + hold.transformed(hx, hy)",false],[362,"    if scale != 1.0:",true],[363,"        d = d.transformed(s=scale)",false],[364,"    return d",true]],"steps":[233,237,233,237,248,250,251,252,253,281,282,287,281,282,287,291,293,298,311,31