{"file":"the-graphite-mind/longform/engine/kitlib/scenes.py","func":"classroom","code":[[382,"def classroom(name=\"classroom\", board_text=None, anim=True):",false],[383,"    \"\"\"Classroom: green chalkboard with tray, wall clock, cork board, window, teacher's desk (left), three student desks, backpacks. board_text writes chalk",false],[384,"    text (one or two short lines) on the board. Anchors: board, teacher_desk, desks (list), window.\"\"\"",false],[385,"    sc = Scene(name)",true],[386,"    d = Drawing()",true],[387,"    sky_day(d, X0, X1, -100, 900)",true],[388,"    sc.far.add(Item(d, 0, 0, 1.0, boil=False))",true],[389,"    cloud_drift(sc.far, 1500, 300, 200, 9) if anim else None",true],[390,"    win = (1470, 190, 1810, 540)",true],[391,"    b = wall_holes(X0, X1, -400, WALL_Y + 2, [win], (246, 236, 200))",true],[392,"    flat(b, X0, 590, X1, WALL_Y + 2, (176, 206, 176))",true],[393,"    b.line([(X0, 590), (X1, 590)], 6, (120, 156, 120))",true],[394,"    floor_band(b, WALL_Y, 1240, (206, 198, 178), (182, 172, 150), \"tile\")",true],[395,"    baseboard(b, WALL_Y, (120, 130, 108))",true],[396,"    sc.back.add(Item(b, 0, 0, 1.0, boil=False))",true],[397,"    fr = Drawing()",true],[398,"    frame_rect(fr, *win, WHITE, 14)",true],[399,"    window_bars(fr, *win, WHITE, 2, 2, 9)",true],[400,"    board = Drawing().fill(rect_pts(234, 176, 1116, 576), C[\"wood\"], width=6)",true],[401,"    board.fill(rect_pts(254, 196, 1096, 556), (48, 94, 70), width=5)",true],[402,"    board.fill(rect_pts(234, 576, 1116, 594), C[\"wood\"], width=5)",true],[403,"    for x, w_ in ((300, 40), (360, 26)):",true],[404,"        board.fill(rect_pts(x, 566, x + w_, 576), WHITE, width=3)",true],[405,"    board.fill(rect_pts(900, 562, 960, 576), (150, 104, 62), width=3.5)",true],[406,"    chalk = (236, 240, 232)",true],[407,"    if board_text:",true],[408,"        lines = board_text.split(\"\\n\")[:2]",false],[409,"        for i, ln in enumerate(lines):",false],[410,"            board.text((675, 330 + i * 110), ln, 80, chalk, HAND)",false],[411,"    else:",false],[412,"        board.text((470, 330), \"A B C\", 90, chalk, HAND)",true],[413,"        board.text((820, 330), \"1+2=3\", 90, chalk, HAND)",true],[414,"        board.line(catmull([(340, 450), (520, 430), (700, 452), (880, 432), (1040, 448)], 8), 4, chalk)",true],[415,"    for k in range(5):",true],[416,"        board.line([(300 + k * 30, 240), (312 + k * 30, 226)], 3, (170, 196, 178))",true],[417,"    fr += board",true],[418,"    fr += _clock(1250, 250, 56)",true],[419,"    cork = Drawing().fill(rect_pts(1170, 340, 1370, 520), C[\"wood\"], width=5)",true],[420,"    cork.fill(rect_pts(1182, 352, 1358, 508), (208, 164, 108), outline=False)",true],[421,"    for x, y, c in ((1210, 380, (250, 240, 200)), (1290, 372, (240, 190, 190)), (1300, 440, (190, 224, 246)), (1220, 450, (250, 226, 150))):",true],[422,"        cork.fill(rect_pts(x, y, x + 56, y + 46), c, width=3)",true],[423,"        cork.dot((x + 28, y + 6), 4, C[\"red\"])",true],[424,"    fr += cork",true],[425,"    sc.back.add(Item(fr, 0, 0, 1.0))",true],[426,"    # mid: teacher desk, student desks",false],[427,"    td = Drawing().fill(rect_pts(-190, -160, 190, -132), C[\"wood_lt\"], width=5)",true],[428,"    td.fill(rect_pts(-170, -132, -110, 0), C[\"wood\"], width=5)",true],[429,"    td.fill(rect_pts(110, -132, 170, 0), C[\"wood\"], width=5)",true],[430,"    td.fill(rect_pts(-104, -132, 104, -40), shade(C[\"wood\"], -0.1), width=4)",true],[431,"    td.circle(-120, -186, 26, C[\"red\"], width=4.5)                    # apple",true],[432,"    td.line([(-120, -212), (-114, -228)], 4)",true],[433,"    td += _book_row(20, -160, 4, seed=8)",true],[434,"    sc.mid.add(Item(td, 300, 900, 1.0))",true],[435,"    desks = []",true],[436,"    for x in (860, 1200, 1540):",true],[437,"        dk = Drawing().fill(rect_pts(-96, -130, 96, -108), C[\"wood_lt\"], width=5)",true],[438,"        dk.fill(rect_pts(-84, -108, -72, 0), C[\"wood\"], width=4)",true],[439,"        dk.fill(rect_pts(72, -108, 84, 0), C[\"wood\"], width=4)",true],[440,"        dk.fill(rect_pts(-84, -70, 84, -60), C[\"wood\"], width=3.5)",true],[441,"        dk.fill(rect_pts(-40, -146, 10, -130), (196, 84, 70), width=3.5)",true],[442,"        dk.line([(30, -138), (76, -138)], 5, C[\"yellow\"])",true],[443,"        sc.mid.add(Item(dk, x, 900, 1.0))",true],[444,"        sc.mid.add(Item(P.chair().transformed(0, 0, 0.62), x - 150, 900, 1.0))",true],[445,"        desks.append((x, 900))",true],[446,"    sc.mid.add(Item(P.backpack(90, 116), 690, 900 - 58, 1.0))",true],[447,"    sc.mid.add(Item(P.backpack(90, 116, (196, 84, 70)), 1690, 900 - 58, 1.0))",true],[448,"    sc.front.add(Item(_potted(150), 90, 1060, 1.0))",true],[449,"    sc.anchors.update(board=(675, 386), teacher_desk=(300, 900), desks=desks, window=(1640, 365))",true],[450,"    return sc",true]],"steps":[387,391,392,393,394,395,398,399,400,401,402,404,405,412,413,414,416,418,419,420,422,423,422,423,422,423,422,423,427,428,429,430,431,432,433,437,438,439,440,441,442,444,437,438,439,440,441,442,444,437,438,439,440,441,442,444,446,447,448],"svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"40 60 1840 1035\" class=\"drawon__svg\"><g data-p=\"0.25\"><path data-k=\"0\" class=\"f\" d=\"M-701 -101 2621 -101 2621 -42 -701 -42 -701 -101Z\" fill=\"#92c4e8\"/><path data-k=\"0\" class=\"f\" d=\"M-701 -45 2621 -45 2621 13 -701 13 -701 -45Z\" fill=\"#97c7e9\"/><path data-k=\"0\" class=\"f\" d=\"M-701 10 2621 10 2621 69 -701 69 -701 10Z\" fill=\"#9bc9ea\"/><path data-k=\"0\" class=\"f\" d=\"M-701 66 2621 66 2621 124 -701 124 -701 66Z\" fill=\"#a0ccea\"/><path data-k=\"0\" class=\"f\" d=\"M-701 121 2621 121 2621 180 -701 180 -701 121Z\" fill=\"#a5ceeb\"/><path data-k=\"0\" class=\"f\" d=\"M-701 177 2621 177 2621 235 -701 235 -701 177Z\" fill=\"#aad1ec\"/><path data-k=\"0\" class=\"f\" d=\"M-701 232 2621 232 2621 291 -701 291 -701 232Z\" fill=\"#aed4ed\"/><path data-k=\"0\" class=\"f\" d=\"M-701 288 2621 288 